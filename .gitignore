# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Build artifacts — never commit these (they were tracked once; see T-03)
# `.angular*` covers the whole Angular build cache and the `.angular.zip` dump.
# It does NOT match `angular.json`, which has no leading dot and stays tracked.
.angular*
openapi-ts-error-*.log
*.zip

# Miscellaneous
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db

# G-02: local secrets — never commit.
# The backend repo has had this block since SEC-01; this one did not, so a `.env` dropped in
# here would have been staged by `git add .` like any other new file. The credentials this
# project actually uses live in `../.env` at the workspace root, outside both repositories —
# these rules cover the copy someone makes locally anyway.
*.env
.env
.env.*
!.env.example
appsettings.Local.json
/playwright-report
/test-results
/e2e
